---
layout: base.njk
title: Book Recommendations
description: Carefully chosen books for younger readers, teens, mythology lovers, beginners, and parents.
---

<div class="prose recommendations-page">

  <p class="breadcrumbs">
    <a href="/">Home</a> / Book Recommendations
  </p>

  <p class="eyebrow">A friendly bookshelf</p>

  <h1>Book recommendations</h1>

  <p class="lead">
    A growing collection of books I would gladly place in a young reader’s hands.
  </p>

  {% set groups = [
    'For Younger Readers',
    'For Teens',
    'Indian Mythology',
    'Beginner Readers',
    'For Parents'
  ] %}

  {% for group in groups %}

    {% set groupBooks = collections.recommendations | selectattr("data.audience", "equalto", group) | list %}

    {% if groupBooks.length > 0 %}

      <section class="recommendation-section">

        <h2>{{ group }}</h2>

        <div class="recommendations-grid">

          {% for item in groupBooks %}

            <article class="book-card">

              <a class="book-cover-link" href="{{ item.url }}">
                <img
                  class="book-cover"
                  src="{{ item.data.cover }}"
                  alt="Cover of {{ item.data.title }}"
                  loading="lazy"
                >
              </a>

              <div class="book-card-content">

                <p class="meta">
                  {{ item.data.author }} · {{ item.data.age }}
                </p>

                <h3>
                  <a href="{{ item.url }}">
                    {{ item.data.title }}
                  </a>
                </h3>

                <p class="book-description">
                  {{ item.data.description }}
                </p>

                <p class="book-why">
                  <strong>Why I recommend it:</strong>
                  {{ item.data.why }}
                </p>

                <a class="read-recommendation" href="{{ item.url }}">
                  Read full recommendation →
                </a>

              </div>

            </article>

          {% endfor %}

        </div>

      </section>

    {% endif %}

  {% endfor %}

</div>