---
layout: base.njk
pagination:
  data: collections.categories
  size: 1
  alias: categoryName
permalink: "/blog/categories/{{ categoryName | slug }}/"
eleventyExcludeFromCollections: true
---
<div class="prose"><p class="breadcrumbs"><a href="/">Home</a> / <a href="/blog/">Blog</a> / {{ categoryName }}</p><h1>{{ categoryName }}</h1>{% for post in collections.posts | byCategory(categoryName) %}<article class="card"><p class="meta">{{ post.date | date }}</p><h2><a href="{{ post.url }}">{{ post.data.title }}</a></h2><p>{{ post.data.description }}</p></article>{% endfor %}</div>
