---
layout: base.njk
permalink: "/blog/{{ title | slug }}/"
---
<article class="prose"><p class="breadcrumbs"><a href="/">Home</a> / <a href="/blog/">Blog</a> / {{ title }}</p><p class="eyebrow">{{ category }}</p><h1>{{ title }}</h1><p class="meta">By {{ author or site.author }} · {{ date | date }}</p><img class="article-image" src="{{ image }}" alt="{{ imageAlt }}"><p class="tags">{% for tag in tags %}<a href="/blog/tags/{{ tag | slug }}/">#{{ tag }}</a>{% endfor %}</p>{{ content | safe }}<hr><h2>Share this article</h2><p><a href="https://www.facebook.com/sharer/sharer.php?u={{ site.url }}{{ page.url }}">Share on Facebook</a> · <a href="https://twitter.com/intent/tweet?url={{ site.url }}{{ page.url }}&text={{ title }}">Share on X</a></p><h2>Thoughts from readers</h2><p>Comments can be enabled with the free, moderated <a href="https://giscus.app">Giscus</a> service. See the README for a simple setup guide.</p></article><script type="application/ld+json">{"@context":"https://schema.org","@type":"Article","headline":"{{ title }}","datePublished":"{{ date | date('yyyy-MM-dd') }}","author":{"@type":"Person","name":"{{ author or site.author }}"},"image":"{{ site.url }}{{ image }}","description":"{{ description }}","mainEntityOfPage":"{{ site.url }}{{ page.url }}"}</script><script type="application/ld+json">{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"{{ site.url }}/"},{"@type":"ListItem","position":2,"name":"Blog","item":"{{ site.url }}/blog/"},{"@type":"ListItem","position":3,"name":"{{ title }}","item":"{{ site.url }}{{ page.url }}"}]}</script>
